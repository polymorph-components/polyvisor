/// polyvisor:internal — the private contract between this repository's own
/// components and its own glue. Both sides of every interface here are
/// built from the same commit, so this package changes freely; its digest
/// is a build-consistency check, never a compatibility promise. The public
/// half is `wit/` (polyvisor:app).
///
/// Realms (docs/design.md "Realms"):
///
///   runtime component — SharedWorker, one per device. Exports the kernel
///                       interfaces; imports the platform interfaces the
///                       worker glue implements plus WASI and polymorph
///                       hosts.
///   visor component   — main thread. A stream-dom producer for the trusted
///                       pixels; imports the kernel interfaces (proxied to
///                       the worker over a MessagePort by the glue) and the
///                       page capabilities in `shell`.
///   app component     — inside a sandboxed frame; targets polyvisor:app.
///                       Its service imports reach the runtime over a port
///                       the glue bound to its session; the kernel sees the
///                       session id the glue supplies, never a claim the
///                       app makes.
///
/// Rules every interface here obeys:
///
///   - Anything that crosses a realm is `async func`. The guest suspends
///     through the component model's async ABI; the glue never wraps an
///     import in `suspending()`, so no realm requires JSPI.
///   - No resources cross this package's seams. Plain data only, so the
///     same calls serialize over a MessagePort today and over process IPC
///     under a native shell tomorrow.
///   - Caller identity is supplied by the glue from the port a call arrived
///     on (`session-id` parameters), never taken from the caller.
package polyvisor:internal@0.1.0;

interface types {
    /// An installed application, as the kernel names it.
    type app-id = string;
    /// A running app instance. Allocated by the kernel at `launch`; never
    /// reused within a runtime instance.
    type session-id = u32;

    enum error-code {
        /// The named app is not installed.
        unknown-app,
        /// No such live session.
        unknown-session,
        /// The kernel is not in a state to serve this (not booted, sealed).
        unavailable,
        /// The request was understood and refused by policy.
        refused,
        /// The thing asked for does not exist.
        not-found,
        /// A dependency failed (network, storage, host).
        failed,
    }

    record error {
        code: error-code,
        /// Framework voice, for the visor to show or log as-is.
        message: string,
    }

    /// Where a pairing ceremony stands. Declared here rather than in
    /// `pairing` because two interfaces need it — `pairing.status` answers
    /// it and `events.event` pushes it — and the runtime world *exports*
    /// `pairing`, so an interface that `use`d it would need it imported and
    /// exported at once (`wasm-tools component wit` refuses exactly that).
    /// `types` is the package's shared vocabulary; this is now part of it.
    variant phase {
        idle,
        /// Joiner: showing the code.
        offering(string),
        /// Adder: dialing and claiming.
        claiming,
        /// Both: the SAS to compare; confirm or cancel.
        awaiting-confirm(string),
        /// Confirmed here, waiting for the other side.
        awaiting-peer,
        /// Enrolled (joiner) or enrolled the peer (adder).
        done,
        /// Framework voice.
        failed(string),
    }

    /// Where a real-time meeting stands: a live exchange of signed
    /// introductions between two devices of *different* users (never
    /// enrollment; the outcome is a contact) over a distinct ALPN. In
    /// `types` because exported `meeting` and `events` both carry it.
    variant meeting-phase {
        idle,
        /// Host: showing the bootstrap link/QR the peer scans or opens.
        offering(string),
        /// Guest: dialing the host named in a bootstrap link.
        dialing,
        /// Both: the SAS to compare and the peer's card to review.
        awaiting-confirm(meeting-review),
        /// Confirmed here, waiting for the other side.
        awaiting-peer,
        /// Completed: the resulting contact's local id.
        done(string),
        /// Framework voice: wrong code, cancelled peer, bad signature.
        failed(string),
    }

    /// A phase plus its session generation: `some` for every active phase,
    /// `none` for idle/terminal. `confirm`/`cancel` carry it so a tab acting
    /// on a meeting a newer `offer`/`join` replaced is rejected as stale.
    /// `u32` matches `session-id` — the kernel counter must be `u32`.
    record meeting-status {
        generation: option<u32>,
        phase: meeting-phase,
    }

    /// The peer's card to review before confirming, extracted from its
    /// *verified* signed self-introduction: the SAS both devices display, the
    /// peer's user signing key (the identity the contact is keyed to, not any
    /// endpoint key), and the claims it offered.
    record meeting-review {
        sas: string,
        peer-key: list<u8>,
        claims: list<tuple<string, string>>,
    }
}

// ---------------------------------------------------------------------------
// Platform: what the glue implements for the runtime component. Implemented
// in TypeScript over browser APIs today, in Rust under a native shell later.
// Everything else the runtime imports is WASI or a polymorph host package.
// ---------------------------------------------------------------------------

/// Small unsealed key/value store (IndexedDB in the browser). Holds only
/// what must be readable before any device is unsealed: the device index
/// and boot caches. Sealed state lives behind `wasi:filesystem`.
interface kv {
    get: async func(key: string) -> option<list<u8>>;
    set: async func(key: string, value: list<u8>);
    delete: async func(key: string);
    /// Keys with the given prefix, in unspecified order.
    keys: async func(prefix: string) -> list<string>;
}

/// Web Locks, read side. The worker glue itself holds this device's lock
/// (`pm-device-<id>`) for the worker's lifetime — a lock releases when its
/// holder dies, which is the liveness signal the sweep needs; the kernel
/// only asks whether some other worker holds one.
interface locks {
    is-held: async func(name: string) -> bool;
}

/// The one expensive root-backup operation. The browser host delegates this
/// call to the dedicated Rust backup worker; the runtime keeps envelope
/// parsing, context validation and encryption in trusted Rust.
interface backup-kdf {
    derive: async func(passphrase: string, salt: list<u8>) -> result<list<u8>, string>;
}

// ---------------------------------------------------------------------------
// Kernel: what the runtime component exports. The visor imports the same
// interfaces; the worker glue proxies them.
// ---------------------------------------------------------------------------

/// Runtime lifecycle. Called once by the worker glue before anything else.
interface lifecycle {
    use types.{error};

    record boot-config {
        /// The home origin, as an absolute URL without a trailing slash.
        /// It may carry a path (a GitHub Pages project site is served
        /// under `/<repo>/`). Release artifacts and, until installation
        /// lands, app bundles are fetched from it.
        home-origin: string,
        /// The device this worker is: the glue's sessionStorage anchor, or
        /// an id the glue minted for a fresh device. The glue names the
        /// SharedWorker after it, so the id must exist before the kernel
        /// does; everything else about the device is the kernel's.
        device: string,
        /// The iroh relay this device binds its endpoint through (the home
        /// origin's `config.json`; the e2e harness runs its own). Live and
        /// untrusted: it carries ciphertext and endpoint ids, nothing else.
        relay: string,
        /// This page's URL without query or fragment: the OAuth redirect.
        page-url: string,
        /// Google Drive API and OAuth bases; `none` = Google's. The e2e
        /// harness points both at a fake.
        drive-api: option<string>,
        drive-oauth: option<string>,
    }

    boot: async func(config: boot-config) -> result<_, error>;
}

/// The device this runtime is.
///
/// Lifecycle: a device starts `fresh` (ephemeral tier: its namespace is
/// swept once its worker is gone and its lease stale). "Keep this device"
/// promotes it to durable and fixes how it rests: `rests-open` leaves the
/// data key in the namespace, so the protection is the browser profile's
/// access control and the visor says so; `passphrase` wraps the key under
/// Argon2id and unsealing is the login, every session. A device that rests
/// under a passphrase boots `sealed`: `status` answers with the id and
/// state only, and every other kernel call is `unavailable` until `unseal`
/// — except `erase`, which needs no key (a forgotten passphrase must not
/// make a device un-erasable), and `store.devices`, which is unsealed by
/// definition. `fresh` is not a gate: an ephemeral device is fully usable,
/// and its colour is freshly minted, so painting it before "keep" gives an
/// impostor nothing.
/// Nothing personal (name or hue) is readable — or renderable — before
/// the seal opens; that is what makes unseal-as-login unspoofable.
interface device {
    use types.{error};

    enum state { fresh, sealed, open }
    enum tier { ephemeral, durable }
    enum rest { rests-open, passphrase }

    record device-status {
        /// Stable per device.
        id: string,
        state: state,
        tier: tier,
        rest: rest,
        /// The device's own label in the index, user voice, readable
        /// before unseal (ruled acceptable in the clear). "" until kept.
        petname: string,
        /// User voice. Randomly named at creation. Empty while sealed.
        name: string,
        /// The anchor colour, degrees on the hue wheel. 0 while sealed.
        hue: u16,
        /// This device's iroh endpoint id (z-base-32, iroh's spelling): what
        /// another device dials. "" while sealed, and until the endpoint is
        /// bound.
        endpoint-id: string,
    }

    status: async func() -> result<device-status, error>;
    set-name: async func(name: string) -> result<_, error>;
    set-hue: async func(hue: u16) -> result<_, error>;

    /// The user's own labels for themself and each installed app — petname,
    /// glyph, whatever the visor settles on. Free-form while
    /// the field set is in flux: keys are the visor's vocabulary, values are
    /// user voice. Personal: lives in the sealed visor document, so
    /// `unavailable` while sealed.
    variant meta-scope { user, app(string) }
    meta: async func(scope: meta-scope) -> result<list<tuple<string, string>>, error>;
    /// Apply only the named fields. `none` deletes a field.
    patch-meta: async func(scope: meta-scope, fields: list<tuple<string, option<string>>>) -> result<_, error>;

    /// Promote to durable. `passphrase = none` is `rests-open`. Idempotent
    /// on the petname; changing the rest of a kept device is `refused`
    /// (reseal is a later milestone).
    keep: async func(petname: string, passphrase: option<string>) -> result<_, error>;
    /// The login. A wrong passphrase is `refused`; the state stays sealed.
    unseal: async func(passphrase: string) -> result<_, error>;
    /// Destroy this device: its namespace and its index row. The worker is
    /// useless afterwards; the visor switches away (`shell.switch-device`).
    erase: async func() -> result<_, error>;
}

/// Peer sync. Connections are between devices of one user's group: a peer
/// that authenticates as a non-member is disconnected after the handshake,
/// and the kernel dials every member it knows at boot. Membership is the
/// user-system document (`polyvisor:us`), itself synced like any tree, so
/// an enrollment on one device reaches every other.
interface sync {
    use types.{error};

    record peer {
        endpoint-id: string,
        /// Framework voice: "connecting", "connected", "closed: <why>".
        state: string,
    }

    record member {
        endpoint-id: string,
        /// User voice; the petname the device was kept under, or "".
        petname: string,
        /// Epoch milliseconds.
        enrolled: u64,
        /// This device.
        me: bool,
    }

    /// Dial a member by endpoint id (a non-member is refused with
    /// `refused`); the boot-time reconnect uses the same path.
    connect: async func(endpoint-id: string) -> result<_, error>;
    peers: async func() -> result<list<peer>, error>;
    /// The device group, this device included.
    members: async func() -> result<list<member>, error>;
}

/// Root-authenticated user identity and optional local root custody.
interface identity {
    use types.{error};

    record identity-status {
        root: list<u8>,
        group: list<u8>,
        has-root: bool,
    }

    /// One complete root-signed current profile. `token` is the exact signed
    /// value and is returned unchanged when resolving, so a stale screen
    /// cannot silently overwrite a concurrent variant.
    record profile-variant {
        token: list<u8>,
        claims: list<tuple<string, string>>,
    }

    record current-profile {
        root: list<u8>,
        variants: list<profile-variant>,
    }

    record root-backup-status {
        has-root: bool,
        synced: bool,
    }

    status: async func() -> result<identity-status, error>;
    profile: async func() -> result<current-profile, error>;
    resolve-profile: async func(expected: list<list<u8>>, claims: list<tuple<string, string>>) -> result<current-profile, error>;
    root-transfer: async func(endpoint-id: string) -> result<_, error>;
    backup-status: async func() -> result<root-backup-status, error>;
    backup-export: async func(passphrase: string) -> result<list<u8>, error>;
    backup-import: async func(passphrase: string, envelope: list<u8>) -> result<_, error>;
    backup-sync-replace: async func(passphrase: string) -> result<_, error>;
    backup-sync-disable: async func() -> result<_, error>;
    backup-sync-unlock: async func(passphrase: string) -> result<_, error>;
}

/// Device pairing: the ceremony that enrolls a device into the group.
///
/// The joining device shows a code (its endpoint id and a single-claim
/// token, 120 s); a device already in the group types or scans it and
/// dials. A commit-then-reveal exchange of nonces yields a six-digit SAS
/// that both devices display and both users confirm in trusted pixels;
/// only then does the adder enroll the joiner (writes it into the
/// user-system document and syncs). No links: pairing is started
/// interactively on both devices. A fresh device with no group is its own
/// group of one; joining replaces that group with the adder's.
interface pairing {
    use types.{error, phase};

    /// Joiner: mint an offer; returns the code. Replaces any open offer.
    offer: async func() -> result<string, error>;
    /// Adder: claim a code shown by another device.
    claim: async func(code: string) -> result<_, error>;
    /// Either side, after comparing the SAS.
    confirm: async func() -> result<_, error>;
    /// Either side, at any point; the other side sees `failed`.
    cancel: async func() -> result<_, error>;
    status: async func() -> result<phase, error>;
}

/// Durable storage on a dumb store the user owns. M4 ships one backend,
/// Google Drive, user-only: every object is written to the user's own
/// Drive under names derived from a key the group holds, and read back by
/// the same names. The store sees ciphertext (app-tree envelopes,
/// keyhive's signed ops, the group document's signed commits) at
/// unguessable names and nothing else. Sync through the store is the
/// non-realtime path: a device that was never online with its peers
/// still converges by pulling what they pushed.
///
/// The OAuth ceremony splits along capabilities: the kernel mints the
/// PKCE verifier and the authorization URL (`oauth-start`), the visor's
/// glue opens the popup (`shell.open-popup`) and relays the returned
/// `code`+`state` (`oauth-complete`); the kernel exchanges them itself
/// over `wasi:http` and seals the tokens beside the device seed. The
/// one-shot code may cross the port; the tokens never do.
interface storage {
    use types.{error};

    record oauth-client {
        /// An installed-app OAuth client id/secret pair. Google documents
        /// the installed-app secret as "not treated as a secret": it
        /// identifies the app and gates nothing without the user's
        /// consent. Nothing is baked in; the user or the operator types it.
        client-id: string,
        client-secret: string,
    }

    record binding {
        /// "gdrive" is the only provider in M4.
        provider: string,
        /// Framework voice: "not connected", "connected",
        /// "connected; the last sync did not finish: <why>" (a transient
        /// failure; the next mutation or "sync now" retries), or
        /// "needs re-authorization: <why>" (the token was refused and a
        /// refresh did not help; the ceremony must run again).
        state: string,
        /// Epoch milliseconds of the last successful pull and push, 0 if
        /// never.
        last-pull: u64,
        last-push: u64,
    }

    status: async func() -> result<binding, error>;
    /// Mint a PKCE ceremony; returns the authorization URL for the popup.
    /// The redirect is the page URL from `boot-config.page-url`.
    oauth-start: async func(client: oauth-client) -> result<string, error>;
    /// The popup landed back with `code` and `state`; exchange and seal.
    oauth-complete: async func(code: string, state: string) -> result<_, error>;
    /// Forget the tokens (does not touch the store).
    disconnect: async func() -> result<_, error>;
    /// Push every local item the store lacks, then pull every item the
    /// store has that this device lacks. Also runs unprompted after every
    /// local change and at boot; this is the visor's "sync now".
    sync-now: async func() -> result<_, error>;
}

/// The device index: what a boot may show before any seal opens. Every
/// device on this origin, for the entry picker. Carries nothing personal
/// beyond the petname.
interface store {
    use types.{error};
    use device.{tier, rest};

    record entry {
        id: string,
        petname: string,
        tier: tier,
        rest: rest,
        /// Epoch milliseconds.
        created: u64,
        last-used: u64,
    }

    devices: async func() -> result<list<entry>, error>;
}

/// Installed apps and their live sessions.
interface apps {
    use types.{app-id, session-id, error};

    record app-info {
        id: app-id,
        /// App voice: the publisher's own title. Rendered plated.
        title: string,
    }

    /// One content-addressed static asset in an app's bundle. `handle` is
    /// what the app puts on the stream (stream-dom's asset attribute
    /// value); the frame resolves it to bytes through `asset`.
    record asset-info {
        handle: list<u8>,
        /// MIME type for the blob the frame mints.
        media-type: string,
    }

    /// A session's component, ready to instantiate. `plan` is the
    /// embedder's build-time translation envelope (polyengine's; the
    /// kernel carries it opaquely so the frame never ships a translator).
    record component-artifacts {
        wasm: list<u8>,
        plan: string,
    }

    /// What a bookmark resolves to: the app it names and the route the app
    /// wrote into it (`polyvisor:app/route`), "" for a plain launch.
    record route-target {
        app: app-info,
        route: string,
    }

    installed: async func() -> result<list<app-info>, error>;
    /// The page fragment (without `#`) that names `session`'s app at
    /// `route` — the bookmarkable form of "this app, here". The kernel
    /// owns the grammar (`app/<token>`) and the token is opaque: install
    /// id and route sealed under the user's route key, deterministically,
    /// so equal state is equal text. `refused` when `route` is over the
    /// kernel's length cap.
    route-encode: async func(session: session-id, route: string) -> result<string, error>;
    /// The inverse: a fragment the visor found on the page, resolved to an
    /// app this device may launch. `not-found` for anything that is not a
    /// fragment this user's route key sealed, including one from another
    /// user's device; `unknown-app` when it names an app no longer
    /// installed.
    route-decode: async func(fragment: string) -> result<route-target, error>;
    /// The fragment an installed app's window opens at: `launch/<app-id>`,
    /// the second kind (docs/design.md "Routing"). Plaintext and keyless
    /// on purpose — a `start_url` is written once into the OS's app
    /// registry and replayed for months, so it must outlive route-key
    /// convergence; and it names a package the launcher already displays,
    /// so there is nothing to hide. `route-decode` resolves it to this
    /// user's install of the package, at route "". `unknown-app` if the
    /// package is not installed.
    install-fragment: async func(app: app-id) -> result<string, error>;
    /// Start an instance. The glue binds a port to the returned session;
    /// the visor opens a frame for it through `shell.open-frame`, and the
    /// frame fetches `component`/`assets`/`asset` over that port, which
    /// the glue answers with the session already filled in.
    launch: async func(app: app-id) -> result<session-id, error>;
    component: async func(session: session-id) -> result<component-artifacts, error>;
    assets: async func(session: session-id) -> result<list<asset-info>, error>;
    asset: async func(session: session-id, handle: list<u8>) -> result<list<u8>, error>;
    /// End a session. The visor's own act, so it emits no event. Idempotent.
    close: async func(session: session-id) -> result<_, error>;
    /// The glue reports a session that died on its own — a frame torn down
    /// by the receiver (policy violation, decode failure) or one that never
    /// mounted. Ends the session and emits `session-ended(session, reason)`
    /// so every visor learns of it through the one event path. `reason` is
    /// framework voice, composed by the glue; publisher text never enters
    /// it. Idempotent; unknown sessions are ignored.
    abort: async func(session: session-id, reason: string);
}

/// Kernel-originated events: a long poll. The runtime exports it and the
/// worker glue runs one pump over that export, fanning each event out to
/// every connected tab's queue; the visor imports it and its own glue
/// serves the poll from that tab's queue. Same interface, two sides of the
/// seam — nothing links the two directly.
///
/// Because the runtime's side parks, an event needs no call to carry it: a
/// transition born of network activity alone (the other device confirming,
/// an enrollment landing, a peer closing) reaches the visor with no press
/// on this device.
interface events {
    use types.{session-id, phase, meeting-status};

    variant event {
        /// A session ended other than through `apps.close`. The string is
        /// the reason, framework voice: the kernel or the glue composed it,
        /// so the visor renders it unplated and plates only the app title.
        session-ended(tuple<session-id, string>),
        /// The pairing ceremony moved: the kernel emits this on every phase
        /// transition, including the ones the visor did not cause (the peer
        /// confirming, an offer expiring, the enrollment landing).
        ///
        /// The visor has no timer and `pairing.status` may not park, so a
        /// ceremony that advances because the *other* device acted has no
        /// other way to reach the screen. `status` remains the authority
        /// and the visor re-reads it after every act of its own; this is
        /// the push that makes waiting cost nothing.
        pairing-changed(phase),
        /// Sealed shared personalization or group membership changed. The
        /// visor re-reads authoritative snapshots and rebases clean fields.
        personalization-changed,
        /// The contacts document changed: a contact created/edited/deleted,
        /// an import accepted, or a meeting wrote one. The visor re-reads
        /// `contacts.list`. Born of network activity too — a paired device's
        /// edit lands here with nothing pressed on this device.
        contacts-changed,
        /// The meeting ceremony moved (like `pairing-changed`): the kernel
        /// emits this on every transition, including ones the peer caused.
        meeting-changed(meeting-status),
    }

    /// Resolves with the next event; parks while there is none.
    next: async func() -> event;
}

/// Service dispatch for app sessions: each public service interface in
/// polyvisor:app has a mirror here with the caller's session first. The
/// glue supplies the session from the port the call arrived on.
interface app-services {
    use types.{session-id};
    use polyvisor:app/tasks@0.1.0.{snapshot};

    tasks-items: async func(session: session-id) -> result<snapshot, string>;
    tasks-watch: async func(session: session-id, after: u64) -> result<snapshot, string>;
    tasks-add: async func(session: session-id, title: string) -> result<string, string>;
    tasks-set-completed: async func(session: session-id, id: string, completed: bool) -> result<_, string>;
    tasks-set-title: async func(session: session-id, id: string, title: string) -> result<_, string>;
    tasks-remove: async func(session: session-id, id: string) -> result<_, string>;
}

/// The user's private contacts: identity bindings, signed disclosures, and
/// the meetings that produced them. Runtime and visor own this; there is no
/// public contacts app service (internal only).
///
/// The store is a new encrypted user document (keyhive-sealed, synced and
/// checkpointed like any app tree, *not* plaintext `polyvisor:us`). Only
/// verified *extracted* observations are persisted; the original signed
/// introduction payload and signature are NEVER stored, logged, or
/// checkpointed. It also holds the user's contact **signing identity** (a
/// seed): a user-level identity synced inside the document, distinct from the
/// device endpoint key, adopted from the established group on pairing.
interface contacts {
    use types.{error};

    /// How a value came to be recorded. `verified` (signature-backed) is the
    /// only third-party-verified category; `local` (manual edit) and
    /// `imported` (unsigned JSON list, no authenticated issuer) are this
    /// device's own assertions.
    enum provenance {
        local,
        imported,
        verified,
    }

    /// A protobuf `google.protobuf.Timestamp`, preserved faithfully rather
    /// than flattened to millis, so no durable precision/range is lost.
    record claimed-time {
        seconds: s64,
        nanos: u32,
    }

    /// One recorded observation: a descriptive claim (issuer assertion, never
    /// consent/authorization) plus its provenance. The user owns the store —
    /// any observation, `verified` included, may be removed; no signature is
    /// retained to contradict, so a removal is a store edit. A historical
    /// correction is a new observation.
    record observation {
        name: string,
        value: string,
        provenance: provenance,
        /// The asserting signing key for a `verified` observation; empty
        /// otherwise. Ed25519, 32 bytes.
        issuer: list<u8>,
        /// The issuer's asserted time for a `verified` observation; `none`
        /// for `local`/`imported` (no authenticated time).
        claimed: option<claimed-time>,
        /// Epoch milliseconds this device recorded it (receipt time).
        received: u64,
        /// The provenance record this references (a stable id from
        /// `meetings`). A meeting, import, and manual edit all make one, so
        /// this is never empty.
        meeting: string,
    }

    /// A contact as the visor lists and inspects it.
    record contact {
        /// Stable, kernel-minted, never reused. 16 bytes lowercase hex. A
        /// keyed contact's id is derived deterministically from its public
        /// key (so two devices importing the same key converge on one
        /// contact); a keyless import gets a random id.
        id: string,
        /// The contact's user signing public key (Ed25519, 32 bytes), or
        /// empty for a keyless imported record.
        public-key: list<u8>,
        /// The user's editable label. Local, visible, independent of any
        /// received "name" claim (never overwritten by a third party), never
        /// secretly exported.
        petname: string,
        /// The user's private glyph label. Never exported as an observation.
        glyph: string,
        /// Complete root-signed profiles retained from a verified
        /// introduction. These are official subject claims and are shown
        /// separately from the importing issuer's observations below.
        official-profiles: list<profile-variant>,
        authenticated: option<authenticated-identity>,
        /// Every recorded observation, in a stable order.
        observations: list<observation>,
        /// The user's preferred value per claim name — the `set-preferred`
        /// override, surfaced so it survives reload. `(name, value)` pairs;
        /// a name absent here has no preference.
        preferred: list<tuple<string, string>>,
    }

    record profile-variant {
        token: list<u8>,
        claims: list<tuple<string, string>>,
    }

    record authenticated-identity {
        binding: list<u8>,
        profiles: list<list<u8>>,
        authority-device: list<u8>,
        authority-proof: list<u8>,
    }

    /// A party in an introduction: the public key and its asserted claims.
    /// The structure `share` signs — the runtime requires the issuer's key to
    /// equal this user's own signing key (mismatch refused, never
    /// overwritten, so a stale value held across an identity adoption cannot
    /// be signed under an unexpected identity) and stamps `issued-at` itself.
    record party {
        /// Ed25519, 32 bytes. Mandatory — a party is never keyless.
        public-key: list<u8>,
        claims: list<tuple<string, string>>,
    }

    /// The exact parties and claims to sign. The visor assembles this from
    /// `items`/`profile` and hands it to `share`; nothing is re-derived from
    /// the mutable store between assembly and signature.
    record introduction {
        issuer: party,
        parties: list<party>,
    }

    /// How and when a value's source happened, and whether it verified. A
    /// separate stable-id collection every observation references — meeting,
    /// import, and manual edit all make one, so provenance is queryable here.
    record meeting-record {
        /// Stable id, kernel-minted. Observations name it.
        id: string,
        /// Framework voice: "met in real time" / "imported from a file" /
        /// "entered by hand".
        method: string,
        /// Local, unauthenticated label (a filename for an import, or a
        /// channel label); empty when there is none.
        source: string,
        /// The peer/issuer signing key for a meeting or signed import; empty
        /// for an unsigned import or manual edit. Ed25519, 32 bytes.
        source-key: list<u8>,
        /// Epoch milliseconds this device recorded the exchange.
        occurred: u64,
        /// Whether a signature was verified over the source bytes.
        verified: bool,
    }

    /// One party of a parsed import, addressable by `index` so a keyless
    /// party (empty key) is still selectable. A signed introduction's parties
    /// verify; an unsigned JSON list's do not (`provenance` says which).
    record import-party {
        /// Stable within this review only; what `selection` addresses.
        index: u32,
        /// Ed25519, 32 bytes, or empty for a keyless party.
        public-key: list<u8>,
        /// The asserting signing key for a signed import; empty for unsigned
        /// JSON. Ed25519, 32 bytes.
        issuer: list<u8>,
        /// The issuer's asserted time for a signed import; `none` unsigned.
        claimed: option<claimed-time>,
        /// `verified` for a signed introduction, `imported` for JSON.
        provenance: provenance,
        claims: list<tuple<string, string>>,
    }

    /// A contact-file import, parsed (and, when signed, verified) but not yet
    /// written. `import-accept` writes only the selected observations; raw
    /// signed bytes are never surfaced or retained.
    record import-review {
        parties: list<import-party>,
        /// Whether the file was a signed introduction or the unsigned JSON
        /// contact list.
        signed: bool,
        /// Framework voice: what the file is and how it verified.
        summary: string,
    }

    record authenticated-identity-review {
        root: list<u8>,
        group: list<u8>,
        profiles: list<list<tuple<string, string>>>,
    }

    record signed-introduction-review {
        identities: list<authenticated-identity-review>,
        parties: list<party>,
        claimed: claimed-time,
    }

    /// Exact observations to keep, addressed by review `index` and exact
    /// `(name, value)` tuples — never by name alone, which is ambiguous when
    /// a party asserts several values for one name.
    record selection {
        index: u32,
        claims: list<tuple<string, string>>,
    }

    // -- reads ---------------------------------------------------------------

    items: async func() -> result<list<contact>, error>;
    get: async func(id: string) -> result<contact, error>;
    /// Every meeting record, newest first — the provenance collection the
    /// visor shows for method/source/time/verification detail.
    meetings: async func() -> result<list<meeting-record>, error>;

    // -- manual CRUD ---------------------------------------------------------

    /// Create a contact by hand. `public-key` empty makes a keyless record
    /// (random id); a key makes a keyed record (deterministic id, converging
    /// with any same-key import). Returns the contact's local id.
    create: async func(public-key: list<u8>, petname: string, glyph: string) -> result<string, error>;
    /// Atomically set the private local label. Never exported as claims.
    set-label: async func(id: string, petname: string, glyph: string) -> result<_, error>;
    /// Add or replace a manual (`local`) observation on a contact.
    set-observation: async func(id: string, name: string, value: string) -> result<_, error>;
    /// Remove an observation by exact `(name, value)`. Allowed for any
    /// provenance including `verified`: the user owns the store and no
    /// signature is retained to contradict.
    remove-observation: async func(id: string, name: string, value: string) -> result<_, error>;
    /// Mark one observed value the user's preferred one for `(id, name)`, a
    /// local override that survives remote claims and is never overwritten by
    /// a third party. `value` is `none` to clear the preference; a `some`
    /// value that is not among the contact's observations for `name` is
    /// `refused`. `none`, not an empty string, clears — an empty observed
    /// value is a valid value and may be preferred.
    set-preferred: async func(id: string, name: string, value: option<string>) -> result<_, error>;
    delete: async func(id: string) -> result<_, error>;
    /// Fold a keyless imported record into an established keyed identity.
    /// Explicit by ruling: different keys are never silently merged.
    /// `keyless` must be keyless; `into` must be keyed.
    merge: async func(keyless: string, into: string) -> result<_, error>;

    // -- introduction share --------------------------------------------------

    /// Sign and serialize the exact `introduction` the user assembled, as a
    /// portable `polyvisor.introduction.v0` card. Takes the immutable value
    /// rather than re-reading the store. The runtime requires
    /// `issuer.public-key` to equal this user's signing key (mismatch
    /// `refused`), stamps `issued-at`, and validates every party's key is
    /// present, non-weak and unique before signing.
    /// Share this user's complete current official profile variants and,
    /// optionally, selected contacts' intact authenticated identities plus
    /// separately labelled issuer observations. There is no selective claim
    /// omission from an official profile.
    share: async func(expected-root: list<u8>, expected-profiles: list<list<u8>>, forwarded-contact-ids: list<string>, expected-forwarded: list<authenticated-identity>, parties: list<party>) -> result<list<u8>, error>;

    // -- import --------------------------------------------------------------

    /// Decode a `#contact/<body>` fragment body (base64url text) into the raw
    /// bytes `import-preview` takes. The runtime owns link encoding; the
    /// visor never protocol-decodes. `refused` for invalid base64url. (The
    /// `#meet/<body>` fragment goes to `meeting.join` verbatim.)
    decode-link: async func(body: string) -> result<list<u8>, error>;
    /// Parse a contact file for review: a signed `polyvisor.introduction.v0`
    /// introduction (verified over the original bytes, never a
    /// reserialization) or the unsigned JSON contact list (no authenticated
    /// issuer/time). `import-review.signed` says which. `refused` for a
    /// signed introduction that does not verify or bytes that are neither
    /// form. Nothing is written.
    import-preview: async func(bytes: list<u8>) -> result<import-review, error>;
    signed-preview: async func(bytes: list<u8>) -> result<signed-introduction-review, error>;
    /// Accept a reviewed import, re-parsing/re-verifying `bytes` and writing
    /// only the observations in `selections`. `source` is a local
    /// unauthenticated label (a filename or channel label) kept on the
    /// meeting-record. Unselected claims and raw signed bytes are never
    /// persisted. Contacts are created or (same key) merged automatically;
    /// different keys never silently. Returns the affected contact ids.
    import-unsigned: async func(bytes: list<u8>, source: string, selections: list<selection>) -> result<list<string>, error>;
    /// Verify and retain a signed introduction as one authenticated contact.
    import-accept: async func(bytes: list<u8>, selected-roots: list<list<u8>>, selected-parties: list<u32>, petname: string, glyph: string) -> result<string, error>;
}

/// Real-time meeting: two devices of *different* users exchange signed
/// self-introductions over a dedicated ALPN, compare a SAS, and each
/// confirms. The outcome is a contact on each side, never a group member —
/// not pairing (which enrols a device into one user's group with a shared
/// seed); a meeting binds two independent identities and shares only the
/// introductions the users chose to present.
///
/// The SAS transcript binds BOTH sides' signed self-introductions (and so
/// their user signing keys) with the endpoint keys, token and nonces — not
/// the transport keys alone — so a late issuer/self-introduction swap changes
/// the digits and is caught. Bootstrap is a link the peer's system camera
/// opens; the visor hands the fragment to `join` after unseal. Never
/// auto-accepted: `join` reaches `awaiting-confirm`, and only an explicit
/// `confirm` on each side completes it.
interface meeting {
    use types.{error, meeting-status};
    use contacts.{party};

    /// Host: mint a token and return the bootstrap link (an absolute URL with
    /// the host endpoint and token in its fragment). Replaces any open offer.
    /// `card` is the exact self-introduction party this user presents
    /// (assembled from `profile`, not re-derived); its `public-key` must be
    /// this user's own signing key. Returns this operation's own
    /// `meeting-status` (generation + phase) so the caller binds to its own
    /// session, not a racy latest-status read another tab may have replaced.
    offer: async func(expected-root: list<u8>, expected-profiles: list<list<u8>>) -> result<meeting-status, error>;
    /// Guest: begin from a bootstrap link's fragment. Dials the host and runs
    /// the exchange up to `awaiting-confirm`; never auto-accepts. `card` as
    /// in `offer`. Returns this operation's own `meeting-status`.
    join: async func(fragment: string, expected-root: list<u8>, expected-profiles: list<list<u8>>) -> result<meeting-status, error>;
    /// After comparing the SAS and reviewing the peer's card. `generation`
    /// must match the current session (a stale one is `refused`, so a tab
    /// confirming a replaced meeting cannot accept the new one). `keep` names
    /// the exact `(name, value)` claims to record. Writes the contact once
    /// the other side also confirms.
    confirm: async func(generation: u32, keep: list<tuple<string, string>>) -> result<_, error>;
    /// Either side, any time; the other sees `failed`. A stale `generation`
    /// is ignored so it cannot tear down a replacement meeting.
    cancel: async func(generation: u32) -> result<_, error>;
    status: async func() -> result<meeting-status, error>;
}

// ---------------------------------------------------------------------------
// Shell: page capabilities the visor imports and its glue implements.
// ---------------------------------------------------------------------------

/// What the visor can do to the page it is drawn into. Geometry of its own
/// tree comes through stream-dom `queries`; this is only what no producer
/// can express.
interface shell {
    use types.{session-id, error};

    /// Put a sandboxed frame for the session into the app zone: the glue
    /// fetches the session's component bytes from the kernel, obtains the
    /// port the worker bound to the session, and posts both into a
    /// constant, hash-pinned srcdoc loader. At most one frame per session.
    ///
    /// `route` is what the frame answers `polyvisor:app/route.get` with:
    /// the route a bookmark carried, or "" for a plain launch. The glue
    /// also writes the page fragment for this session (`apps.route-encode`)
    /// here, on every `route.set` the frame relays, and clears it in
    /// `close-frame`: the URL bar belongs to the one open session, and the
    /// glue owns it (`history.replaceState` only — an app never gets a
    /// history entry; docs/design.md "Routing").
    open-frame: async func(session: session-id, route: string) -> result<_, error>;
    /// Tear the frame down. Idempotent.
    close-frame: async func(session: session-id) -> result<_, error>;
    /// The page's fragment without its `#`, or `none` when there is none.
    /// Read once per page load by the visor, after unseal, and handed to
    /// `apps.route-decode`; the visor never parses it.
    fragment: func() -> option<string>;
    /// Re-anchor this tab to another device (or, with `none`, to a fresh
    /// one) and reload: the anchor is the tab's sessionStorage pointer and
    /// the worker is named after it, so a device switch is a page reload.
    switch-device: func(device: option<string>);
    /// `navigator.storage.persist()` — a window capability, asked at the
    /// moment a device is kept. `false` means the browser declined; the
    /// device is durable regardless, only more evictable.
    request-persistence: async func() -> bool;
    /// Open `url` in a popup and resolve with the `code` and `state` query
    /// parameters the popup returns to this page's URL with; `none` if the
    /// ceremony did not come back: consent was declined, or nothing
    /// returned within the glue's bound. A window is a page capability, so
    /// the ceremony's browser half lives here and the kernel never sees a
    /// window.
    open-popup: async func(url: string) -> option<tuple<string, string>>;

    /// This page's URL without query or fragment (the same value the kernel
    /// received in `boot-config.page-url`). The visor needs it to compose a
    /// meeting bootstrap link the peer's system camera can open back to this
    /// origin. A plain `func`: it reads a property of the page the visor is
    /// already in, crossing no realm.
    page-url: func() -> string;
    /// Put `text` on the system clipboard — a share-my-contact link or card.
    /// A window capability, so it lives here; `refused` if the browser
    /// denied the write.
    copy-text: async func(text: string) -> result<_, error>;
    /// Ask the user for a contact file to import and read its bytes. Answers
    /// `none` when the user cancelled the picker (a settled non-error), or
    /// the filename and bytes otherwise. Input is bounded by the glue before
    /// it crosses; the kernel bounds it again before parsing.
    read-contact-file: async func() -> result<option<tuple<string, list<u8>>>, error>;
    /// Offer `bytes` to the user as a download named `name` — a portable
    /// contact card the kernel signed. The glue mints and revokes the blob
    /// URL; `refused` if the browser denied it.
    save-contact-file: async func(name: string, bytes: list<u8>) -> result<_, error>;

    /// What the visor asks the page to install an app as: the fields of a
    /// web app manifest the glue cannot know. `title` is app voice, shown
    /// by the OS launcher unplated, so the glue composes the manifest name
    /// from it and the framework's own; `hue` is the user's, for the
    /// window's theme colour and for the icon's ground.
    ///
    /// `glyph` is the *saved* app glyph (`device.meta`, `meta-scope.app`,
    /// the visor's `glyph` key) — never an unsaved draft: an install writes
    /// into the OS's app registry, so what it paints has to be something
    /// the user committed to. Empty means the user set none, and the glue
    /// falls back to the framework's own static icons.
    ///
    /// A worker-served icon reaches an Android launcher only if the install
    /// uses image bytes the browser itself fetched: a remote WebAPK-minting
    /// server cannot reach a service worker, whose responses exist only
    /// inside this browser. Which of the two the Android path does is the
    /// open question (docs/design.md "Routing").
    record install-request {
        /// From `apps.install-fragment`: what the installed window opens at.
        fragment: string,
        title: string,
        hue: u16,
        /// The saved app glyph, or "" for none.
        glyph: string,
    }

    /// How an install request ended on the page.
    enum install-outcome {
        /// The browser's install prompt was shown; whatever the user chose
        /// there is the browser's business.
        prompted,
        /// The manifest is in place but the browser offered no prompt to
        /// call: the user installs from the browser's own menu.
        manual,
    }

    /// Install `request`'s app as its own installed web app: the glue mints
    /// a manifest for it — `id`, `start_url` and `scope` written absolute
    /// against the page's own base, so a `blob:` manifest resolves nothing
    /// relative to itself — points the document's manifest link at it, and
    /// calls the install prompt the browser offered earlier, if any.
    ///
    /// With a non-empty `glyph` the glue first paints the glyph on the
    /// user's hue at 512 and 192, stores the PNGs in a dedicated Cache
    /// Storage cache under opaque content-digest URLs, and names those URLs
    /// in the manifest; a service worker on the home origin is what answers
    /// them. Any failure along that path — no service worker, no canvas, no
    /// activation in time — falls back to the framework's static icons, so
    /// an install never fails for want of art.
    install-app: async func(request: install-request) -> result<install-outcome, error>;
}

// ---------------------------------------------------------------------------
// Worlds
// ---------------------------------------------------------------------------

/// The runtime component: kernel + engine, in the device's SharedWorker.
world runtime {
    import kv;
    import locks;
    import backup-kdf;
    import wasi:clocks/monotonic-clock@0.3.1;
    import wasi:clocks/system-clock@0.3.1;
    import wasi:random/random@0.3.1;
    import wasi:http/client@0.3.1;
    /// The state root: the glue preopens the origin's OPFS at `/`; the
    /// kernel keeps each device under `/<id>/`. The 0.3 track is async in
    /// WIT — except four stream-returning functions (`read-directory` and
    /// the three `*-via-stream`), and the OPFS host answers
    /// `read-directory` with a Promise. So the kernel never lists a
    /// directory: every path it touches is named, from a generation
    /// pointer it keeps in `kv`. That is what keeps the kernel's filesystem
    /// path JSPI-free — as every realm now is (docs/design.md "No JSPI").
    import wasi:filesystem/types@0.3.1;
    import wasi:filesystem/preopens@0.3.1;
    /// The transport. The endpoint component (polymorph-iroh's, composed
    /// in at build time with `wac plug`) implements these; what the glue
    /// sees are the endpoint's own imports (websocket, webrtc, webcrypto,
    /// a sockets stub).
    import polymorph:iroh/endpoint@0.1.0;
    /// The device's signing identity rests as an Ed25519 seed inside the
    /// sealed checkpoint (the "seed" posture), and the endpoint is built
    /// from that seed directly: `identity-from-seed` holds the private key
    /// in the endpoint component's own memory and signs there, rather than
    /// behind an async crypto import. Sync signing is what lets this realm
    /// run without JSPI; the trade is recorded in docs/design.md
    /// "No JSPI". The interface is `@unstable(feature =
    /// guest-ed25519-signing)`, so every tool that reads this world needs
    /// that feature enabled (justfile `wit`, `endpoint`; the runtime
    /// component's `generate!`).
    import polymorph:iroh/identity-from-seed@0.1.0;

    export lifecycle;
    export device;
    export sync;
    export identity;
    export pairing;
    export storage;
    export store;
    export apps;
    export events;
    export app-services;
    export contacts;
    export meeting;
}

/// The visor component: the trusted pixels, on the main thread.
world visor {
    include polymorph:stream-dom/producer@0.1.0;
    import wasi:random/random@0.3.1;

    import device;
    import sync;
    import identity;
    import pairing;
    import storage;
    import store;
    import apps;
    import events;
    import shell;
    import contacts;
    import meeting;
}
