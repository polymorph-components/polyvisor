# runtime/ — the embedding runtime's own gates.
#
# The device store (device-store/, PERSISTENCE.md's T-C) is browser
# machinery: IndexedDB, OPFS, Web Locks, WebCrypto handle persistence,
# sessionStorage. None of it can be asserted in Deno, so its gate is a
# BROWSER-DRIVEN PROBE MATRIX in the shape the worker-host spike
# established (spikes/worker-host/justfile): bundle a page, serve it on
# an ephemeral port, drive it with Playwright, print a verdict per row.
#
# Pinned in ONE place, as demo/justfile explains at length: the version
# below is both what `deps` installs a browser for and what
# tests/devstore/run.ts imports. A mismatch downloads a browser revision
# the library will not launch.

PLAYWRIGHT := "npm:playwright@1.57.0"
DEVSTORE := "tests/devstore"

default: test

# Type-check every device-store module and the harness.
#
# RESOLUTION MODEL (runtime/README.md): the runtime's modules import
# bare specifiers that the EMBEDDER maps. The device-store CORE modules
# import no package at all, so they check under any config; the probe
# page needs @polyengine/wasi and the WORKER HOST needs the whole engine
# graph, so the config that maps them lives with the harness
# (tests/devstore/deno.json, pins copied from demo/deno.json) and every
# check here runs against it.
check:
    cd {{DEVSTORE}} && deno check --config deno.json \
        ../../device-store/*.ts page.ts run.ts

# The demo's engine artifacts: build/engine.plan.json (the translated
# envelope) + ../engine/target/composed.wasm (the composite). Delegated
# to the demo rather than copied, so the worker host is measured against
# the SAME bytes the demo ships (spikes/worker-host/justfile's reasoning,
# verbatim).
artifacts:
    cd ../demo && just translate

# Bundle the probe page AND the device host for the browser, and
# assemble serve/.
#
# THE WORKER IS BUNDLED SEPARATELY from the page, and has to be: a
# SharedWorker script is its own module graph with its own global scope,
# constructed with {type:"module"} (device-store/client.ts). It is also
# the only one of the two that pulls in the engine, which is why only it
# needs the --external set.
#
# The --external set is the demo's, verbatim, and for the demo's reason
# (demo/justfile's `site` recipe): the webrtc port's NODE backends must
# stay bare specifiers or deno resolves their `node:` builtins into URLs
# the browser then fails to fetch. The greps below are the tripwires.
#
# BOTH bundles need it, which is worth a sentence because it is not
# obvious: the worker imports ../engine.ts to instantiate the composite,
# and the PAGE imports ../pairing-engine.ts (row 18 proves the visor's
# PairingDriver adapter is constructible over the remote driver) — and
# pairing-engine.ts takes `hex`/`unhex` from engine.ts as VALUES, not
# types, so the whole import record comes with them. The page still
# instantiates nothing; it just carries the graph.
build: check artifacts
    mkdir -p {{DEVSTORE}}/serve
    cd {{DEVSTORE}} && deno bundle --config deno.json --platform browser \
        --external node-datachannel --external "node-datachannel/polyfill" --external werift \
        -o serve/page.js page.ts
    cd {{DEVSTORE}} && deno bundle --config deno.json --platform browser \
        --external node-datachannel --external "node-datachannel/polyfill" --external werift \
        -o serve/worker.js ../../device-store/worker.ts
    # No `node:` builtin may survive into either bundle: the browser would
    # try to fetch it as a URL and the page (or the worker) would die
    # before the first probe (demo/justfile's `site` documents the
    # failure).
    ! grep -q 'node:' {{DEVSTORE}}/serve/page.js || \
        { echo "serve/page.js imports a node: builtin" >&2; exit 1; }
    ! grep -q 'node:' {{DEVSTORE}}/serve/worker.js || \
        { echo "serve/worker.js imports a node: builtin — check the --external set" >&2; exit 1; }
    cp {{DEVSTORE}}/probe.html {{DEVSTORE}}/serve/
    cp ../demo/build/engine.plan.json {{DEVSTORE}}/serve/engine.plan.json
    cp ../engine/target/composed.wasm {{DEVSTORE}}/serve/engine.component.wasm

# The browser Playwright needs. PROBE-THEN-INSTALL (demo/justfile's
# `e2e-deps`, verbatim reasoning): a launch that already works is left
# alone, so this is a no-op after the first run.
deps:
    #!/usr/bin/env bash
    set -euo pipefail
    if deno eval "import { chromium } from '{{PLAYWRIGHT}}';
                  const b = await chromium.launch({ args: ['--no-sandbox'] });
                  await b.close();" >/dev/null 2>&1; then
        echo "playwright chromium: already launchable"
    else
        echo "playwright chromium: installing…"
        pwver="{{PLAYWRIGHT}}"; pwver="${pwver#npm:playwright@}"
        if command -v npx >/dev/null 2>&1; then
            if [ -n "${CI:-}" ]; then
                npx --yes "playwright@${pwver}" install --with-deps chromium
            else
                npx --yes "playwright@${pwver}" install chromium
            fi
        else
            if [ -n "${CI:-}" ]; then deno run -A {{PLAYWRIGHT}} install-deps chromium || true; fi
            deno run -A {{PLAYWRIGHT}} install chromium
        fi
    fi

# THE GATE: the whole device-store matrix in a real headless Chromium.
test: deps build
    cd {{DEVSTORE}} && deno run -A --config deno.json run.ts

# Serve the probe for hand-driving (`globalThis.probe(op, arg)` in a
# console). Ephemeral port, read back from the server's own output.
probe-serve: build
    deno run --allow-net --allow-read jsr:@std/http/file-server {{DEVSTORE}}/serve --port 0

clean:
    rm -rf {{DEVSTORE}}/serve {{DEVSTORE}}/last-run.json
