package polyvisor:engine@0.1.0;

/// The engine spike (#20 G2): the walking skeleton's content spine
/// generalized from a linear chain to the real automerge change DAG, with
/// the `polyvisor:tasks` service served from inside the engine
/// composite (demo-v1 topology). Chunk identity = automerge ChangeHash;
/// chunk parents = the change's deps = keyhive predecessor refs =
/// sedimentree parents — one DAG across all three layers.
interface driver {
    /// One webcrypto identity backing keyhive and subduction; both layers
    /// built, tasks service ready to bind a partition. Returns the id, hex.
    /// `exportable-identity` selects the G5 demo-grade SOFT key (in-guest,
    /// bundle-exportable) instead of the platform-held default — the
    /// webcrypto interface has no private-key export at this rev (a #11
    /// data point; the export/recovery format is the identity bundle).
    ///
    /// PLATFORM POSTURE CONSULTS `device-identity` FIRST: an embedder that
    /// persists a device key hands it over here and the engine adopts it
    /// rather than minting, which is what makes a reload the SAME device.
    /// `none` mints through the port, as before.
    init: async func(exportable-identity: bool) -> result<string, string>;

    // --- keyhive membership (synced by the bridge over the wire) ---
    //
    // Agent ids are 32-byte identifiers; individuals, groups, and docs
    // share the id space. G3: users are GROUPS of device individuals —
    // partitions are delegated to groups, sharing adds the other user's
    // group, and "lost phone" and "removed collaborator" are the same
    // revocation mechanic at different nodes of the delegation graph.

    kh-knows-agent: async func(agent-id: list<u8>) -> result<bool, string>;

    /// Create a group; the caller's individual is its first (admin) member.
    kh-create-group: async func() -> result<list<u8>, string>;

    /// Enroll an agent into a group. `level` is one of "read", "edit",
    /// "admin". Adding to a group propagates CGKA adds to every doc that
    /// (transitively) contains the group — from the next epoch onward.
    kh-add-to-group: async func(group-id: list<u8>, member-id: list<u8>, level: string) -> result<_, string>;

    /// Revoke an agent from a group ("lost phone"): docs containing the
    /// group drop CGKA leaves for individuals no longer reachable.
    kh-revoke-from-group: async func(group-id: list<u8>, member-id: list<u8>) -> result<_, string>;

    /// Export the constitutive events reachable to an agent (a "group
    /// card"): bincoded static events, carried out of band (QR/paste in
    /// the product; the host in this spike). The bridge only offers a
    /// group's ops to its members, so sharing with a foreign group needs
    /// its card ingested first.
    kh-export-card: async func(agent-id: list<u8>) -> result<list<u8>, string>;

    /// Ingest a pasted card. Returns how many events stayed pending
    /// (unresolvable until more context arrives).
    kh-ingest-card: async func(card: list<u8>) -> result<u32, string>;

    /// `level` is one of "read", "edit", "admin" (authors need "edit":
    /// subduction's put policy requires it). The agent may be an
    /// individual or a group (transitive members get CGKA leaves).
    kh-add-member: async func(doc-id: list<u8>, agent-id: list<u8>, level: string) -> result<_, string>;
    kh-revoke-member: async func(doc-id: list<u8>, agent-id: list<u8>) -> result<_, string>;

    /// Keyhive contact card (bincode): materializes the individual +
    /// prekeys on ingest. The enrollment/QR artifact for devices that
    /// have never touched the wire.
    kh-contact-card: async func() -> result<list<u8>, string>;
    kh-ingest-contact: async func(card: list<u8>) -> result<_, string>;

    // --- the bucket path (#19's pull layer under this engine; G4, plus
    // --- the spikes/dropbox link-capability strategy) ---
    //
    // Two provider strategies behind one surface (wit/blobstore.wit is
    // the generalized draft). S3: object names HMAC-derived from
    // per-epoch name-keys; members bootstrap from a per-member K_p pickup
    // object wrapped to keyhive contact-card prekeys; the keyhive op
    // stream is stored as name-keyed blobs so a cold device can join from
    // the bucket alone. Dropbox: plain derivable paths under a per-doc
    // folder whose shared link is the pull capability; pickup objects are
    // per-member sealed files with their own revocable links; revocation
    // is server-side, hard, and retroactive.

    /// Addressing only: the signing authority arrives as the wired
    /// `store-signer` instance and the wired `store-owner-fetch`
    /// instance, never as config bytes (#11). `access-key` is a public
    /// identifier that appears in the Authorization header in clear.
    record s3-config {
        endpoint: string,
        bucket: string,
        access-key: string,
    }

    /// Consumer Dropbox (app-folder app). Addressing only: the app
    /// identifiers, the user's bearer token and its refresh live in the
    /// wired `store-owner-fetch` instance, and the link-tier app auth in
    /// the wired `store-shared-fetch` instance. Which tier a call runs
    /// at is decided by which import it goes through, not by whether a
    /// token happens to be present in guest state.
    record dropbox-config {
        root: string,
    }

    /// Google Drive: the USER-ONLY store (runtime/DRIVE.md). Addressing
    /// only, like every other arm — and here there is no credential at
    /// all, not even a public identifier like S3's access key: the
    /// user's OAuth tokens and their refresh live in the wired
    /// `store-owner-fetch` instance. `api-base` defaults to
    /// `https://www.googleapis.com` and is config for the same reason
    /// S3's `endpoint` is: a self-hosted (or fake) backend is ordinary
    /// addressing, not a probe hack (§2).
    ///
    /// THE CLIENT ID IS DELIBERATELY NOT HERE. Auth is entirely the
    /// wired seam's; the guest has no use for an app identity it must
    /// never wield itself — though note that `drive.file` scope confines
    /// per client id, so every device of an account must consent with
    /// the SAME one to see the same store (§2).
    ///
    /// USER-ONLY, structurally (§1): this provider mints NO capability —
    /// no shared links, no anonymous tier, no app tier. The only readers
    /// are holders of the user's own OAuth, wired to
    /// `store-owner-fetch`; `store-public-fetch` and
    /// `store-shared-fetch` are wired over empty origin sets and the
    /// gdrive paths never call them.
    record gdrive-config {
        root: string,
        api-base: string,
    }

    variant store-config {
        s3(s3-config),
        dropbox(dropbox-config),
        gdrive(gdrive-config),
    }

    /// Addressing only — no credentials cross this boundary. Which
    /// account, which tier, and whether writes are possible at all are
    /// properties of the wired egress/signer instances (#7, #11).
    init-store: async func(config: store-config) -> result<_, string>;

    /// S3: create the bucket + public-read-no-list policy. Dropbox:
    /// ensure the root folders (doc folders + links are minted lazily).
    /// Google Drive: ensure the root / `docs` / `pickup` folders (doc
    /// folders are resolved-or-created lazily; nothing is ever minted).
    ensure-bucket: async func() -> result<_, string>;

    /// Publish/refresh the member's pickup object, sealed to a keyhive
    /// contact-card prekey DH. S3: K_p (name-key keychain + author
    /// device list) at the derivable location — returns none. Dropbox:
    /// the sealed pickup file (doc folder link + device list), plus the
    /// file's own minted link, returned — the member's standing
    /// capability, carried by the caller in lieu of the E2E channel.
    /// Google Drive: the sealed pickup object at a derivable location —
    /// returns NONE, and the none is a ruling, not an omission
    /// (DRIVE.md §1): the account's own devices need the pickup to
    /// bootstrap, and there is no link to carry because there is nothing
    /// a link could grant.
    store-grant: async func(doc-id: list<u8>, member-id: list<u8>) -> result<option<string>, string>;

    /// Revoke the member's pickup and rotate the pull tier. S3: delete
    /// K_p + rotate the name-key epoch, republish for the remaining
    /// grantees (cooperative now, hard forward). Dropbox: revoke +
    /// delete their pickup link, revoke + re-mint the doc folder link,
    /// rewrite remaining pickups in place (hard + retroactive,
    /// server-side). Returns a human-readable guarantee note for the UI
    /// — the blobstore draft's guarantee class, as prose for now.
    /// Google Drive: delete the pickup object and return the honest note
    /// (DRIVE.md §1) — this store never minted a capability, so there is
    /// nothing server-side to revoke; a party holding the user's own
    /// Drive credential is outside this store's reach, and credential
    /// rotation at Google is the real lever.
    store-revoke: async func(doc-id: list<u8>, member-id: list<u8>) -> result<string, string>;

    /// Push new chunks (envelope bytes), the op-stream blob, and the
    /// signed manifest. Owner tier: rides `store-owner-fetch` (plus
    /// `store-signer` on S3). An instance wired without write authority
    /// fails with the wired instance's own refusal.
    bucket-flush: async func(doc-id: list<u8>) -> result<string, string>;

    /// Pull: op stream into keyhive, chunks into the sedimentree, then
    /// apply. Works with zero live connections. `pickup` is the standing
    /// pickup link for link-tier recipients, and on Dropbox its PRESENCE
    /// is what selects the link tier (the guest can no longer see whether
    /// it holds a token, and must not infer authority from state); S3
    /// derives the K_p location instead and ignores it. Google Drive is
    /// OWNER TIER ONLY and REFUSES a `pickup` BY NAME (DRIVE.md §1): a
    /// link-tier pull is not a thing this provider has.
    bucket-pull: async func(doc-id: list<u8>, owner-id: list<u8>, pickup: option<string>) -> result<string, string>;

    // --- the identity bundle (#20 G5; #11's persistence slice) ---
    //
    // One sealed bundle (keyhive archive + identity key + partition
    // refs) under a random bundle key held in KEYSLOTS, LUKS-style: a
    // passphrase slot (argon2id — the downloadable-file wrap) and/or a
    // raw 32-byte-secret slot (passkey-PRF / recovery-code stand-in).
    // Everything else rehydrates from the bucket (G4), so this bundle
    // plus store config is a complete device restart.

    /// Export the sealed bundle. At least one slot must be requested.
    identity-export: async func(label: string, passphrase: option<string>, secret-slot: option<list<u8>>) -> result<list<u8>, string>;

    /// Initialize this instance FROM a bundle (instead of `init`):
    /// restores identity + keyhive state and binds the tasks service to
    /// the bundled partition. Returns the identity id, hex.
    identity-import: async func(bundle: list<u8>, passphrase: option<string>, secret: option<list<u8>>) -> result<string, string>;

    // --- state persistence (#20 G5; runtime/PERSISTENCE.md "Engine
    // --- contract additions") ---
    //
    // The engine treats ONE preopened directory as its state root: the
    // per-device OPFS directory in the browser, a real directory under
    // wasmtime/Deno. If the embedder mounted no directory (the fresh-boot
    // default — `@polyengine/wasi`'s batteries `wasi()` ships an
    // empty-preopens filesystem stub), both calls below are inert:
    // `state-resume` answers `false` and `state-checkpoint` reports that
    // there is no state root. Nothing about an engine that is never
    // checkpointed changes.
    //
    // THE MOUNT IS THE SEALED BOUNDARY. The engine writes PLAINTEXT into
    // its state root — keyhive archive, chunk-envelope keys, and (in
    // `seed` posture) the identity seed itself. Encryption at rest is the
    // embedder's job: PERSISTENCE.md's per-device DEK wraps the directory
    // the engine is handed, not the bytes the engine writes. An embedder
    // that mounts an unsealed directory has chosen an unsealed device.

    /// Write a crash-consistent snapshot of everything needed to resume:
    /// the keyhive archive, the sedimentree chunk store (signatures
    /// preserved — commits are re-stored, never re-signed), every held
    /// partition's automerge state, the chunk-envelope keys, the active
    /// partition binding and the user-system doc/group binding.
    ///
    /// ATOMICITY: generation directories plus a manifest written LAST.
    /// Each checkpoint writes `gen-<n>/` fresh and only then writes
    /// `gen-<n>/MANIFEST` (magic + payload + trailing digest, one file
    /// write). `state-resume` takes the HIGHEST generation whose manifest
    /// parses AND whose every member file matches its recorded digest, so
    /// a kill at any instant leaves the previous generation intact and
    /// selected. No rename is relied on: OPFS `rename-at` is emulated by
    /// copy+delete and is not atomic.
    ///
    /// Cadence is the EMBEDDER's: there is no timer in the guest.
    ///
    /// Deliberately NOT captured: a partition created but not yet
    /// sealed (it was never committed — losing it is the correct crash
    /// semantics), the bucket/store configuration (embedder-supplied
    /// addressing, re-applied on resume), and live wire state.
    ///
    /// In `platform` posture the snapshot is written WITHOUT identity
    /// material — the private half is a non-extractable host handle the
    /// guest cannot see. Such a checkpoint is complete in every other
    /// respect: its resume takes the identity from the `device-identity`
    /// import instead, and the manifest's recorded agent id is what the
    /// handed key is checked against.
    state-checkpoint: async func() -> result<_, string>;

    /// Resume from the state root INSTEAD of `init` — the embedder calls
    /// this first and only calls `init` if it answers `false`.
    ///
    /// `true`: a valid checkpoint was found and this instance is now the
    /// device it describes — same identity, same keyhive, same chunk
    /// store, partitions re-bound and their content intact. `false`: the
    /// state root is absent or holds no valid generation, so the caller
    /// should `init` a fresh device. Errors are real faults (a corrupt
    /// state root, an unsupported posture), never "nothing there".
    ///
    /// `seed` posture restores the identity from the persisted material.
    /// `platform` posture takes it from the `device-identity` import
    /// instead — a non-extractable handle the guest cannot see was never
    /// written down, so it arrives from OUTSIDE the checkpoint. The handed
    /// pair is verified against the manifest's recorded agent id first: a
    /// mismatch is an error naming both, because it means either a corrupt
    /// state root or the wrong device's namespace. An embedding whose
    /// import answers `none` gets an explicit refusal, never a silent
    /// downgrade to a fresh identity.
    state-resume: async func() -> result<bool, string>;

    // --- the iroh wire + subduction sync (from the skeleton) ---

    iroh-bind: async func(relay-url: string) -> result<string, string>;
    iroh-start: async func(initiator: bool, peer-endpoint-id: list<u8>, relay-url: string, expected-peer: list<u8>) -> result<u32, string>;
    conn-status: async func(conn: u32) -> result<option<string>, string>;
    sync-start: async func(peer: list<u8>, tree: list<u8>, subscribe: bool) -> result<u32, string>;
    sync-status: async func(handle: u32) -> result<option<string>, string>;

    // --- partition lifecycle (the create → add members → seal ordering
    // --- is load-bearing: epoch membership at seal time determines
    // --- readability) ---

    /// Create the partition: keyhive doc + the automerge creation change
    /// (the todos map), held UNSEALED so members can be added first.
    create-partition: async func() -> result<list<u8>, string>;

    /// Encrypt and commit the pending creation change under the current
    /// epoch, and bind the tasks service to this partition.
    seal-partition: async func(id: list<u8>) -> result<_, string>;

    /// Bind the tasks service to a partition this instance did not create
    /// (members receive everything through sync).
    adopt-partition: async func(id: list<u8>) -> result<_, string>;

    /// DAG evidence: (chunks known, max parent count over chunks).
    chunk-stats: async func(id: list<u8>) -> result<tuple<u32, u32>, string>;

    // --- device pairing (#10) ---

    record pair-offer {
        code: string,        // BASE32_NOPAD_VISUAL(version ‖ endpoint-id ‖ token)
        expires-ms: u64,
    }

    record pair-enrollment {
        user-group-id: list<u8>,
        partition-id: list<u8>,
        /// THE ADDER'S IDS, AS THE JOINER OBSERVED THEM in this ceremony.
        ///
        /// Pairing grants MEMBERSHIP; it does not wire subduction. The
        /// embedder must do that (§2 step 7), and to dial it needs the
        /// other end's endpoint id and the agent id to expect there.
        /// Before this, a joiner had a membership and no way to name the
        /// device that granted it — so every embedder had to smuggle the
        /// adder's ids in out of band, which a real two-page deployment
        /// cannot do.
        ///
        /// BOTH ARE OBSERVED, NEVER ASSERTED BY THE PEER. The endpoint id
        /// is the transport-authenticated dialer (`connection.peer()`:
        /// iroh proved the holder of that key before the connection was
        /// delivered). The agent id is the ISSUER of the delegation in
        /// the ENROLL card that made this device a member — a signature
        /// over the grant itself, not a self-declared field. Neither can
        /// be a name the peer merely claimed.
        ///
        /// Empty = not observed (an ENROLL card carrying no delegation to
        /// this device would be a broken ceremony, so an empty agent id
        /// is a fault to report, never a value to dial with).
        peer-agent-id: list<u8>,
        peer-endpoint-id: list<u8>,
    }

    variant pair-join-state {
        waiting,
        claimed(string),          // SAS — display, await pair-join-confirm
        confirmed-waiting,
        enrolled(pair-enrollment),
        expired,
        failed(string),
    }

    variant pair-add-state {
        connecting,
        sas-ready(string),        // SAS — display, await pair-add-confirm
        waiting-peer,
        enrolled,
        failed(string),
    }

    pair-join-start:   async func() -> result<pair-offer, string>;
    pair-join-status:  async func() -> result<pair-join-state, string>;
    pair-join-confirm: async func() -> result<_, string>;

    pair-add-start:    async func(code: string) -> result<_, string>;
    pair-add-status:   async func() -> result<pair-add-state, string>;
    /// device-name: the user's own word for the new device (the visor's
    /// voice, #22) — recorded in the devices annotations by the ADDER.
    pair-add-confirm:  async func(device-name: string) -> result<_, string>;

    pair-abort:        async func() -> result<_, string>;

    // --- user-system partition (#36) ---

    record us-profile {
        display-name: string,
        hue: u16,                 // OKLCH hue index per #22 palette
        icon: option<list<u8>>,   // small; blob-attachment pattern later
    }

    record us-mark {
        provenance: string,
        petname: string,
        /// The canonical pet-icon glyph: a single Unicode scalar from the
        /// visor's curated set (#22). The ENGINE treats this as an opaque
        /// string and repairs uniqueness on exact equality only —
        /// confusability across glyphs is handled visor-side, by
        /// construction of the curated set (one glyph per visual class).
        icon: string,
        nickname: option<string>,
        created-at: u64,
        needs-reconfirm: bool,    // set by conflict repair; cleared by us-mark-confirm
    }

    record us-device {
        agent-id: list<u8>,
        name: string,
        enrolled-at: u64,
        revoked: bool,
    }

    variant us-event {
        profile-changed,
        mark-added(string),                       // provenance
        mark-changed(string),
        mark-conflict-repaired(tuple<string, string>), // (provenance, "petname"|"icon")
        device-added(string),                     // name
        device-revoked(string),
    }

    /// First device only: create user group + user-system partition,
    /// write the initial profile. Returns the user group id.
    user-create:     async func(profile: us-profile) -> result<list<u8>, string>;

    us-profile-get:  async func() -> result<us-profile, string>;
    us-profile-set:  async func(profile: us-profile) -> result<_, string>;

    us-marks-list:   async func() -> result<list<us-mark>, string>;
    us-mark-put:     async func(mark: us-mark) -> result<_, string>;
    us-mark-forget:  async func(provenance: string) -> result<_, string>;
    us-mark-confirm: async func(provenance: string) -> result<_, string>;

    /// A named pointer to one of the account's data partitions. The map
    /// lives in the user-system document, so it SYNCS: a device that was
    /// just paired learns the account's tasks partition (and any later
    /// one) by reading it, rather than needing the id handed to it out of
    /// band. The id is a keyhive doc id, opaque here; the name is the
    /// account's own short label ("tasks").
    record us-partition {
        name: string,
        id: list<u8>,
    }

    /// Upsert the pointer under `name`. Requires an existing user system
    /// — same error convention as `us-profile-set` when there is none.
    ///
    /// DELIBERATELY WITHOUT a `us-event` case: consumers poll
    /// `us-partitions` (a joiner reads it once, at adoption time), and a
    /// new event case would force a fresh arm through every adapter's
    /// exhaustive match for a signal nobody edge-triggers on. Keeping the
    /// event enum stable is the cheaper contract.
    us-partition-put: async func(name: string, id: list<u8>) -> result<_, string>;

    /// Every pointer the account has published, name-ordered.
    us-partitions: async func() -> result<list<us-partition>, string>;

    us-contacts-list: async func() -> result<list<tuple<list<u8>, string>>, string>;
    us-contact-put:   async func(card: list<u8>, petname: string) -> result<_, string>;

    us-devices-list:  async func() -> result<list<us-device>, string>;
    us-device-revoke: async func(agent-id: list<u8>) -> result<_, string>;

    /// Drain remotely-caused changes the visor must announce (#22).
    /// Local-echo suppression is engine-side: a device never receives
    /// events for its own writes.
    us-events: async func() -> result<list<us-event>, string>;

    stats: async func() -> string;
}

/// THE EMBEDDER-HELD DEVICE IDENTITY (#20 G5; runtime/PERSISTENCE.md
/// "Engine contract additions"; the webcrypto#391 ruling).
///
/// An APP-OWNED interface, deliberately: "store a handle" is
/// browser-specific, so persistence of the device signing key is an
/// EMBEDDER library and the guest-facing function belongs to this world
/// rather than to the `polymorph:webcrypto` port. The browser embedder
/// implements it by loading the persisted non-extractable `CryptoKey`
/// from the device namespace and laundering it into the port's typed
/// handles through `SigningKey.fromCryptoKey` / `VerifyingKey.fromCryptoKey`
/// (the merged webcrypto#392 seams, shipped in 0.4.0).
///
/// The posture story it completes: `platform` posture rests as a
/// non-extractable handle the guest cannot see, so it never enters a
/// checkpoint. It arrives from OUTSIDE — here.
interface device-identity {
    use polymorph:webcrypto/signature@0.1.0.{signing-key, verifying-key};

    /// The embedder-held device identity, if this embedding persists one.
    ///
    /// Consulted at platform-posture init AND platform-posture resume:
    ///
    /// - `init(exportable-identity: false)` — `some(pair)` adopts the
    ///   handed identity (the agent id is derived from the handed
    ///   verifying key, exactly as for a minted pair); `none` mints a
    ///   fresh pair through the port, which is the unchanged behavior of
    ///   an embedding that grants no persistence.
    /// - `state-resume` of a `platform`-posture checkpoint — `some(pair)`
    ///   is VERIFIED against the checkpoint (the recorded agent id must
    ///   equal the id derived from the handed verifying key) and then
    ///   becomes the resumed device's signer; `none` is an explicit
    ///   refusal, never a silent downgrade to a fresh identity.
    ///
    /// The mismatch check is corrupt-state / wrong-device detection, not
    /// trust: the restored archive's delegations only verify under the
    /// right key anyway, so a wrong key would fail later and far less
    /// legibly.
    ///
    /// Keys travel as the PAIR because the port mints them as pairs and a
    /// `signing-key` carries no accessor to its verifying half.
    ///
    /// `none` is the default an embedder gets for free: a host that fills
    /// this import with a stub answering `none` is byte-for-byte the
    /// engine it was before this interface existed.
    device-key-pair: async func() -> option<tuple<signing-key, verifying-key>>;
}

/// The shared shape of the storage egress imports below. Named as its
/// own interface so the tier-specific world imports (owner / app /
/// anonymous) are the SAME interface type under different import names
/// (#7: authority lives in the instance, selection is by import name).
interface store-fetch-types {
    record response {
        status: u16,
        body: list<u8>,
    }
}

world engine {
    import polymorph:iroh/endpoint@0.1.0;
    import polymorph:iroh/identity-generate@0.1.0;

    /// The embedder-held device identity (see the interface above). The
    /// world import MUST be filled at instantiation, so every embedder
    /// supplies at least the `none`-answering default —
    /// runtime/engine.ts's `newEngine` ships one, and the worker host
    /// overrides it with the device namespace's persisted handle.
    import device-identity;

    /// Storage egress, owner tier: the instance wired here carries the
    /// user's storage authority (SigV4-signed or bearer-injected AT THE
    /// SEAM, per provider). Selection by import name (#7): a call site
    /// that goes through this import is asking to act as the user, and
    /// attaching the wrong credential is inexpressible rather than
    /// checked. The guest never sees the credential.
    import store-owner-fetch: interface {
        use store-fetch-types.{response};

        request: async func(method: string, url: string, headers: list<tuple<string, string>>, body: list<u8>) -> result<response, string>;
    }

    /// Storage egress, anonymous tier: link/name-secrecy reads. The wired
    /// instance never carries identity; the seam strips any authorization
    /// header the guest may have set. Anonymity is a property of which
    /// import the call site went through, not of a runtime check.
    import store-public-fetch: interface {
        use store-fetch-types.{response};

        request: async func(method: string, url: string, headers: list<tuple<string, string>>, body: list<u8>) -> result<response, string>;
    }

    /// Storage egress, app tier: carries the APP's identity (app-auth)
    /// and never the user's. The link-tier recipient path lives here:
    /// Dropbox requires an authenticated caller for shared-link fetches,
    /// but the caller identity is the app key every shipped client
    /// embeds — public identifiers, not user identity. Routing it
    /// through its own import keeps the anonymity property structural: a
    /// recipient-path read CANNOT identify the user, because the user's
    /// credential is wired to a different import.
    import store-shared-fetch: interface {
        use store-fetch-types.{response};

        request: async func(method: string, url: string, headers: list<tuple<string, string>>, body: list<u8>) -> result<response, string>;
    }

    /// SigV4 signature service over an escrowed signing credential the
    /// guest can never read (#11: a non-extractable key handle held
    /// host-side). Returns lowercase hex of the final HMAC. The
    /// implementation is expected to REFUSE out-of-scope requests
    /// (service != "s3", wrong region) — a raw SigV4 key would be valid
    /// account-wide, whereas this handle is narrower than the key, which
    /// is the whole point.
    import store-signer: interface {
        sign: async func(string-to-sign: string, date: string, region: string, service: string) -> result<string, string>;
    }

    export driver;
    export polyvisor:tasks/tasks@0.1.0;
}
