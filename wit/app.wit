/// polyvisor:app — the public contract: everything code from outside this
/// repository links against. Apps target `world app`; data services and
/// providers target the worlds added beside it. This package is public but
/// unstable: it changes with known consumers while the project has no users.
/// `runtime/wit` (polyvisor:internal) is the private half.
///
/// An app's authority is its import set. The framework links each import
/// according to the user's grants: an import the user has not granted is
/// either unlinked (instantiation fails) or linked to a refusing stub,
/// per interface. Nothing here is ambient.
package polyvisor:app@0.1.0;

/// The first data service: a shared task list.
///
/// A schema-authority contract: one live service owns a partition of task
/// data — its schema, policy and migrations — and any number of apps
/// project it. Apps never see documents; they see this.
///
/// `items` is a full snapshot and `watch` parks for a newer revision.
interface tasks {
    record todo-item {
        /// Stable, opaque, unique within the partition.
        id: string,
        title: string,
        completed: bool,
    }

    /// A consistent view of the partition.
    record snapshot {
        /// Monotonic on one replica; equal means the snapshot is unchanged.
        revision: u64,
        /// Items ordered by creation position, then id to break concurrent ties.
        items: list<todo-item>,
    }

    /// Apply any newly synced changes, then snapshot.
    items: async func() -> result<snapshot, string>;
    /// Park until this session's snapshot revision differs from `after`, then
    /// return the new full snapshot. Returns immediately when already newer.
    /// Closing the session settles a parked call with an error.
    watch: async func(after: u64) -> result<snapshot, string>;
    /// Create a task; returns its id.
    add: async func(title: string) -> result<string, string>;
    set-completed: async func(id: string, completed: bool) -> result<_, string>;
    set-title: async func(id: string, title: string) -> result<_, string>;
    remove: async func(id: string) -> result<_, string>;
}

/// Raw Automerge history for one application-private document partition.
/// The application owns the document schema and authors every change; the
/// runtime only validates, persists, and synchronizes its history. Snapshot
/// bytes are an Automerge save, and `revision` is monotonic on this replica.
interface history {
    record snapshot {
        revision: u64,
        bytes: list<u8>,
    }

    /// Read the latest complete saved history.
    read: async func() -> result<snapshot, string>;
    /// Park until this replica advances beyond `after`. Session shutdown
    /// settles a parked watch with an error.
    watch: async func(after: u64) -> result<snapshot, string>;
    /// Publish raw Automerge changes. Every dependency must already exist or
    /// be present in this batch. Duplicate changes are idempotent, invalid or
    /// incomplete batches are rejected atomically, and success means the
    /// accepted history is durably checkpointed on this device.
    publish: async func(changes: list<list<u8>>) -> result<_, string>;
}

/// The app's place in the visor's bookmarkable URL.
///
/// The visor's page fragment names the running app and carries one opaque
/// string the app chose: its route. The visor seals the pair under a key
/// only this user's devices hold before it reaches the URL bar, so the
/// route is never readable off the page, and a route this app is handed
/// is one it wrote itself on one of the user's own devices — not
/// attacker-typed input. What the app puts in it is its own business
/// (TodoMVC: its filter). Bounded: the framework refuses a route over its
/// cap (a few hundred bytes) and the URL does not move.
///
/// `set` replaces the URL; it never pushes history. The back button is
/// the visor's, not the app's.
interface route {
    /// The route the app was launched at: "" for a plain launch.
    get: func() -> string;
    /// Replace the route in the page's URL. Fire-and-forget.
    set: func(route: string);
}

/// An application. Renders through the stream-dom producer contract into
/// a receiver the framework owns (a sandboxed frame under a vocabulary
/// policy); everything else it can reach is an import listed here.
world app {
    include polymorph:stream-dom/producer@0.1.0;
    import tasks;
    import route;
}

/// An application that owns its Automerge schema directly.
world markdown-app {
    include polymorph:stream-dom/producer@0.1.0;
    import history;
}
